---
import DSGVOBadge from './DSGVOBadge.astro';
import type { Tool } from '../lib/schema';

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const pricingLabel = {
  free: 'FREE',
  freemium: 'FREEMIUM',
  paid: 'PAID',
  enterprise: 'ENTERPRISE',
}[tool.pricing_model || 'paid'] || 'PAID';

const pricingClass = `pricing-${tool.pricing_model || 'paid'}`;
---

<article class="card-tool">
  <div class="flex items-start gap-4">
    {tool.logo_url && (
      <img src={tool.logo_url} alt={`${tool.name} Logo`} class="w-12 h-12 object-contain flex-shrink-0 rounded-lg" loading="lazy" style="filter: brightness(0.95);" />
    )}
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap mb-2">
        <h3 class="text-base font-semibold" style="color: var(--text-primary);">
          <a href={`/tools/${tool.slug}`} class="hover:text-[var(--accent)] transition-colors">{tool.name}</a>
        </h3>
        <span class={pricingClass}>
          {pricingLabel}
        </span>
        {tool.has_free_tier && <span class="pricing-free">FREE-TIER</span>}
      </div>
      <p class="text-sm leading-relaxed mb-3" style="color: var(--text-secondary);">{tool.description_de}</p>
      <div class="flex items-center gap-2 flex-wrap">
        <DSGVOBadge status={tool.dsgvo_status} serverLocation={tool.server_location} />
        {tool.headquarters && <span class="font-mono text-xs" style="color: var(--text-muted);">{tool.headquarters}</span>}
      </div>
    </div>
  </div>
  <div class="mt-4 pt-4 flex gap-3" style="border-top: 1px solid var(--border-subtle);">
    <a href={`/tools/${tool.slug}`} class="text-sm font-medium hover:text-[var(--accent)] transition-colors" style="color: var(--text-secondary);">Details &rarr;</a>
    {tool.affiliate_url ? (
      <a href={tool.affiliate_url} target="_blank" rel="noopener sponsored" class="text-sm font-medium ml-auto hover:text-[var(--success)] transition-colors" style="color: var(--accent);">Jetzt testen &nearr;</a>
    ) : (
      <a href={tool.website_url} target="_blank" rel="noopener" class="text-sm font-medium ml-auto hover:text-[var(--text-primary)] transition-colors" style="color: var(--text-muted);">Website &nearr;</a>
    )}
  </div>
</article>
